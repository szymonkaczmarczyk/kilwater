---
import Base from "./Base.astro";
import { pagePath, toLocale, type PageKey } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    metaTitle: string;
    page: PageKey;
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale).legal;
---

<Base title={frontmatter.metaTitle} description={frontmatter.description} page={frontmatter.page} solidNav>
  <article class="legal">
    <header class="legal__head">
      <a class="legal__back" href={pagePath("home", locale)}>
        <span aria-hidden="true">←</span>
        {t.back}
      </a>
      <p class="label">{t.label}</p>
      <h1 class="legal__title">{frontmatter.title}</h1>
      <p class="legal__meta">{t.validFrom} <span class="legal__placeholder">{t.validFromPlaceholder}</span></p>
      {t.translationNote && <p class="legal__meta">{t.translationNote}</p>}
    </header>

    <nav class="legal__toc" aria-label={t.toc}>
      <p class="legal__toc-title">{t.toc}</p>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.slug}`}>{section.text}</a></li>
        ))}
      </ol>
    </nav>

    <div class="legal__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    display: grid;
    gap: var(--space-7);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-8)) var(--gutter) var(--space-10);
  }

  .legal__head {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .legal__head .label {
    color: var(--text-muted);
  }

  .legal__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--hit-target);
    margin-bottom: var(--space-4);
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
  }

  .legal__title {
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: var(--weight-light);
    line-height: var(--leading-heading);
    letter-spacing: -0.04em;
  }

  .legal__meta {
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .legal__placeholder {
    color: var(--accent);
  }

  .legal__toc {
    padding: var(--space-5);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .legal__toc-title {
    margin-bottom: var(--space-3);
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .legal__toc ol {
    display: grid;
    margin: 0;
    padding-left: var(--space-5);
    font-size: var(--size-small);
  }

  .legal__toc a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .legal__body {
    max-width: var(--measure);
    font-size: var(--size-body);
  }

  .legal__body :global(h2) {
    margin: var(--space-8) 0 var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: var(--size-h4);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-display-caps);
    text-transform: uppercase;
    scroll-margin-top: calc(var(--nav-height) + var(--space-5));
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(p),
  .legal__body :global(li) {
    color: var(--text-muted);
  }

  .legal__body :global(p + p),
  .legal__body :global(p + ul),
  .legal__body :global(p + ol),
  .legal__body :global(ul + p),
  .legal__body :global(ol + p) {
    margin-top: var(--space-4);
  }

  .legal__body :global(ul),
  .legal__body :global(ol) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
  }

  .legal__body :global(strong) {
    color: var(--text-strong);
    font-weight: var(--weight-semibold);
  }

  .legal__body :global(a) {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (hover: hover) {
    .legal__toc a:hover,
    .legal__back:hover {
      color: var(--accent);
    }
  }

  @media (min-width: 1024px) {
    .legal {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
    }

    .legal__head {
      grid-column: 1 / -1;
      margin-bottom: var(--space-6);
    }

    .legal__toc {
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
      align-self: start;
    }

    .legal__body {
      grid-column: 5 / span 7;
    }
  }
</style>
