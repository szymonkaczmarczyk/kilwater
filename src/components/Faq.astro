---
import LineIcon from "./LineIcon.astro";
import { faqItems } from "../data/faq";
import { company } from "../data/company";
import { questionLimits } from "../lib/assistant-limits";

const suggestions = [
  "Czym różni się rejs ze skipperem od rejsu z pełną załogą?",
  "Kiedy na Cykladach wieje meltemi?",
  "Czy z małym dzieckiem lepiej wybrać katamaran?",
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
});
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq__inner">
    <div class="faq__aside">
      <header class="faq__intro">
        <p class="label">Pytania przed rejsem</p>
        <h2 id="faq-title" class="section-title">O co pytają nas<br />najczęściej</h2>
        <p class="section-lead">
          Nie ma tu Twojego pytania? Zapytaj asystenta albo napisz na <a class="faq__mail" href={`mailto:${company.email}`}>{company.email}</a>.
        </p>
      </header>

      <div class="assistant" data-assistant>
        <div class="assistant__head">
          <span class="assistant__icon" aria-hidden="true"><LineIcon name="compass" /></span>
          <div>
            <h3 class="assistant__title">Zapytaj asystenta</h3>
            <p class="assistant__badge">Odpowiedzi z bazy wiedzy Kilwater</p>
          </div>
        </div>

        <form class="assistant__form" data-assistant-form novalidate>
          <label class="assistant__label" for="assistant-question">Twoje pytanie o rejs</label>
          <textarea
            class="assistant__field"
            id="assistant-question"
            name="question"
            rows="2"
            maxlength={questionLimits.max}
            placeholder="Na przykład: co zabrać na tydzień na jachcie?"
            aria-describedby="assistant-count assistant-note"
            data-assistant-question
          ></textarea>
          <div class="assistant__trap" aria-hidden="true">
            <label for="assistant-website">Nie wypełniaj tego pola</label>
            <input id="assistant-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p class="assistant__error" role="alert" data-assistant-error>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l9.5 17h-19L12 3Z M12 10v4.5 M12 17.5v.5"></path></svg>
            <span data-assistant-error-text></span>
          </p>
          <div class="assistant__row">
            <p class="assistant__count" id="assistant-count" data-assistant-count>0 / {questionLimits.max}</p>
            <p class="assistant__shortcut"><kbd>Enter</kbd> wysyła</p>
            <button class="button button--solid assistant__submit" type="submit" data-assistant-submit>
              <span data-assistant-submit-label>Zapytaj</span>
              <span class="button__arrow" aria-hidden="true">→</span>
            </button>
          </div>
        </form>

        <div class="assistant__reply" aria-live="polite" data-assistant-reply hidden>
          <p class="assistant__asked" data-assistant-asked></p>
          <div class="assistant__loading" data-assistant-loading hidden>
            <span class="assistant__dots" aria-hidden="true"><span></span><span></span><span></span></span>
            Asystent przygotowuje odpowiedź
          </div>
          <div class="assistant__answer" data-assistant-answer hidden>
            <svg class="assistant__notice-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6 M12 7.5v.5"></path></svg>
            <div class="assistant__answer-body">
              <p class="assistant__matched" data-assistant-matched hidden></p>
              <p class="assistant__text" data-assistant-text></p>
            </div>
          </div>
          <a class="link-underline assistant__cta" href="/#zapytanie" data-assistant-cta hidden>
            <span data-assistant-cta-label></span> <span aria-hidden="true">→</span>
          </a>
          <div class="assistant__related" data-assistant-related hidden>
            <p class="assistant__suggestions-label" id="assistant-related-label">Podobne pytania:</p>
            <ul aria-labelledby="assistant-related-label" data-assistant-related-list></ul>
          </div>
        </div>

        <div class="assistant__suggestions">
          <p class="assistant__suggestions-label" id="assistant-suggestions-label">Możesz zacząć od:</p>
          <ul aria-labelledby="assistant-suggestions-label">
            {suggestions.map((suggestion) => (
              <li><button class="assistant__chip" type="button" data-assistant-suggestion>{suggestion}</button></li>
            ))}
          </ul>
        </div>

        <p class="assistant__note" id="assistant-note">
          Asystent automatycznie dobiera odpowiedź z naszej bazy pytań i działa na serwerze Kilwater. Pytania nie trafiają
          do firm zewnętrznych i nie są zapisywane. Wiążące informacje dostaniesz od brokera.{" "}
          <a href="/polityka-prywatnosci#asystent-na-stronie">Jak działa asystent</a>
        </p>
      </div>
    </div>

    <div class="faq__list">
      {faqItems.map((item, index) => (
        <details class="faq__item" open={index === 0}>
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={structuredData} />
</section>

<script>
  import { company } from "../data/company";
  import { questionLimits } from "../lib/assistant-limits";

  type AssistantResponse = {
    ok: boolean;
    kind?: "answer" | "unsure" | "unknown" | "blocked";
    text?: string;
    link?: { href: string; label: string };
    matchedQuestion?: string;
    related?: string[];
    error?: string;
    reason?: string;
  };

  const assistant = document.querySelector<HTMLElement>("[data-assistant]");
  const pick = <T extends HTMLElement = HTMLElement>(name: string) =>
    assistant?.querySelector<T>(`[data-assistant-${name}]`) ?? null;

  const form = pick<HTMLFormElement>("form");
  const field = pick<HTMLTextAreaElement>("question");
  const count = pick("count");
  const submit = pick<HTMLButtonElement>("submit");
  const submitLabel = pick("submit-label");
  const errorBox = pick("error");
  const errorText = pick("error-text");
  const reply = pick("reply");
  const asked = pick("asked");
  const loading = pick("loading");
  const answer = pick("answer");
  const answerText = pick("text");
  const matched = pick("matched");
  const cta = pick<HTMLAnchorElement>("cta");
  const ctaLabel = pick("cta-label");
  const related = pick("related");
  const relatedList = pick("related-list");

  const failureMessages: Record<string, string> = {
    rate_limited: "To dużo pytań w krótkim czasie. Spróbuj ponownie za kilka minut.",
    unavailable: `Asystent jest chwilowo niedostępny. Napisz do nas na ${company.email}.`,
    error: "Nie udało się przygotować odpowiedzi. Spróbuj zadać pytanie jeszcze raz.",
    offline: "Brak połączenia z internetem. Sprawdź połączenie i spróbuj ponownie.",
  };

  const mailtoFor = (question: string) =>
    `mailto:${company.email}?subject=${encodeURIComponent("Pytanie o rejs")}&body=${encodeURIComponent(question)}`;

  const showError = (message: string) => {
    if (errorText) errorText.textContent = message;
    errorBox?.classList.toggle("is-visible", Boolean(message));
    field?.setAttribute("aria-invalid", message ? "true" : "false");
  };

  const updateCount = () => {
    if (count && field) count.textContent = `${field.value.length} / ${questionLimits.max}`;
  };

  const setLoading = (isLoading: boolean) => {
    if (submit) {
      submit.disabled = isLoading;
      submit.setAttribute("aria-busy", String(isLoading));
    }
    if (submitLabel) submitLabel.textContent = isLoading ? "Czekaj" : "Zapytaj";
    if (loading) loading.hidden = !isLoading;
  };

  const showCta = (href: string, label: string) => {
    if (!cta || !ctaLabel) return;
    cta.href = href;
    ctaLabel.textContent = label;
    cta.hidden = false;
  };

  const showRelated = (questions: string[]) => {
    if (!related || !relatedList) return;
    relatedList.replaceChildren(
      ...questions.map((question) => {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "assistant__chip";
        button.textContent = question;
        button.addEventListener("click", () => askFromChip(question));
        item.append(button);
        return item;
      }),
    );
    related.hidden = questions.length === 0;
  };

  const showReply = (body: AssistantResponse, question: string) => {
    if (!answer || !answerText || !matched) return;
    answer.dataset.kind = body.kind;
    answerText.textContent = body.text ?? "";
    matched.textContent = body.matchedQuestion ? `Najbliższe pytanie w naszej bazie: „${body.matchedQuestion}”` : "";
    matched.hidden = !body.matchedQuestion || body.matchedQuestion.toLowerCase() === question.toLowerCase();
    answer.hidden = false;

    if (body.link) showCta(body.link.href, body.link.label);
    else if (body.kind === "unsure" || body.kind === "unknown") showCta(mailtoFor(question), `Napisz na ${company.email}`);
    showRelated(body.related ?? []);

    answer.classList.remove("is-entering");
    void answer.offsetWidth;
    answer.classList.add("is-entering");
  };

  const resetReply = () => {
    if (answer) answer.hidden = true;
    if (cta) cta.hidden = true;
    if (related) related.hidden = true;
  };

  const ask = async (question: string) => {
    const trimmed = question.replace(/\s+/g, " ").trim();
    if (trimmed.length < questionLimits.min) {
      showError(`Wpisz pytanie, co najmniej ${questionLimits.min} znaki.`);
      field?.focus();
      return;
    }

    showError("");
    resetReply();
    if (reply) reply.hidden = false;
    if (asked) asked.textContent = trimmed;
    setLoading(true);

    const website = form?.querySelector<HTMLInputElement>("#assistant-website")?.value ?? "";
    try {
      const response = await fetch("/api/asystent", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: trimmed, website }),
      });
      const body: AssistantResponse = await response.json().catch(() => ({ ok: false }));
      if (body.ok && body.kind && body.text) {
        showReply(body, trimmed);
        if (field) field.value = "";
        updateCount();
      } else {
        if (reply) reply.hidden = true;
        showError(body.error ?? failureMessages[body.reason ?? "error"] ?? failureMessages.error);
      }
    } catch {
      if (reply) reply.hidden = true;
      showError(failureMessages.offline);
    } finally {
      setLoading(false);
    }
  };

  const askFromChip = (question: string) => {
    if (submit?.disabled || !field) return;
    field.value = question;
    updateCount();
    ask(question);
  };

  let warmedUp = false;
  const warmUp = () => {
    if (warmedUp) return;
    warmedUp = true;
    fetch("/api/asystent").catch(() => {
      warmedUp = false;
    });
  };

  if (form && field && assistant) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!submit?.disabled) ask(field.value);
    });

    field.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey && !event.isComposing) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    field.addEventListener("input", () => {
      updateCount();
      if (errorBox?.classList.contains("is-visible")) showError("");
    });

    field.addEventListener("focus", warmUp, { once: true });

    assistant.querySelectorAll<HTMLButtonElement>("[data-assistant-suggestion]").forEach((chip) => {
      chip.addEventListener("click", () => askFromChip(chip.textContent?.trim() ?? ""));
    });

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        warmUp();
        observer.disconnect();
      },
      { rootMargin: "800px 0px" },
    ).observe(assistant);
  }
</script>

<style>
  .faq {
    position: relative;
    background: var(--surface-page);
    padding: var(--space-9) var(--gutter);
  }

  .faq__inner {
    display: grid;
    gap: var(--space-7);
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .faq__aside {
    display: contents;
  }

  .faq__intro {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-5);
    order: 1;
  }

  .faq__intro .label {
    color: var(--text-muted);
  }

  .faq__mail {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .faq__list {
    order: 2;
    border-top: 1px solid var(--line-soft);
    interpolate-size: allow-keywords;
  }

  .faq__item {
    border-bottom: 1px solid var(--line-soft);
  }

  .faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 450ms var(--ease-out),
      content-visibility 450ms allow-discrete;
  }

  .faq__item[open]::details-content {
    block-size: auto;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 64px;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--size-h4);
    font-weight: var(--weight-regular);
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-soft);
    border-radius: 50%;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 1px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq__item[open] .faq__icon {
    border-color: var(--accent);
  }

  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__answer {
    max-width: var(--measure);
    padding: 0 0 var(--space-5);
    color: var(--text-muted);
  }

  .assistant {
    order: 3;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  .assistant__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .assistant__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--hit-target);
    height: var(--hit-target);
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
  }

  .assistant__icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .assistant__title {
    font-family: var(--font-display);
    font-size: var(--size-h4);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .assistant__badge {
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  .assistant__form {
    display: grid;
    gap: var(--space-2);
  }

  .assistant__label {
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
  }

  .assistant__field {
    width: 100%;
    min-height: 88px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    background: var(--surface-page);
    color: var(--text-strong);
    font: inherit;
    font-size: var(--size-body);
    resize: vertical;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .assistant__field::placeholder {
    color: var(--text-muted);
  }

  .assistant__field:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .assistant__field[aria-invalid="true"] {
    border-color: var(--danger);
  }

  .assistant__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .assistant__error {
    display: none;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--size-small);
    color: var(--danger);
  }

  .assistant__error.is-visible {
    display: flex;
  }

  .assistant__error svg,
  .assistant__notice-icon {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .assistant__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .assistant__count,
  .assistant__shortcut {
    font-size: var(--size-label);
    color: var(--text-muted);
  }

  .assistant__shortcut kbd {
    padding: 2px 6px;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--size-label);
  }

  .assistant__submit {
    margin-left: auto;
  }

  .assistant__submit:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .assistant__suggestions {
    display: grid;
    gap: var(--space-2);
  }

  .assistant__suggestions-label {
    font-size: var(--size-label);
    color: var(--text-muted);
  }

  .assistant__suggestions ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assistant :global(.assistant__chip) {
    width: 100%;
    min-height: var(--hit-target);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-strong);
    font: inherit;
    font-size: var(--size-small);
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .assistant__reply {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-soft);
  }

  .assistant__reply[hidden],
  .assistant__loading[hidden],
  .assistant__answer[hidden],
  .assistant__cta[hidden] {
    display: none;
  }

  .assistant__asked {
    justify-self: end;
    max-width: 90%;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-deep);
    color: var(--text-on-deep);
    font-size: var(--size-small);
  }

  .assistant__loading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .assistant__dots {
    display: inline-flex;
    gap: 4px;
  }

  .assistant__dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: assistant-dot 1.2s var(--ease-out) infinite;
  }

  .assistant__dots span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .assistant__dots span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .assistant__answer {
    display: flex;
    gap: var(--space-3);
  }

  .assistant__answer .assistant__notice-icon {
    display: none;
  }

  .assistant__answer:not([data-kind="answer"]) {
    color: var(--text-muted);
  }

  .assistant__answer:not([data-kind="answer"]) .assistant__notice-icon {
    display: block;
  }

  .assistant__answer-body {
    display: grid;
    gap: var(--space-2);
  }

  .assistant__matched {
    font-size: var(--size-label);
    color: var(--text-muted);
  }

  .assistant__matched[hidden],
  .assistant__related[hidden] {
    display: none;
  }

  .assistant__related {
    display: grid;
    gap: var(--space-2);
  }

  .assistant__related ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assistant__answer.is-entering {
    animation: assistant-answer-in 450ms var(--ease-out) both;
  }

  .assistant__text {
    max-width: var(--measure);
  }

  .assistant__cta {
    justify-self: start;
    gap: var(--space-2);
  }

  .assistant__note {
    font-size: var(--size-label);
    line-height: var(--leading-body);
    color: var(--text-muted);
  }

  .assistant__note a {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @keyframes assistant-dot {
    0%,
    100% {
      opacity: 0.25;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  @keyframes assistant-answer-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (hover: hover) {
    .faq__question:hover .faq__icon {
      border-color: var(--text-strong);
    }

    .assistant :global(.assistant__chip:hover) {
      border-color: var(--accent);
      background: var(--surface-page);
    }
  }

  @media (pointer: coarse) {
    .assistant__shortcut {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .assistant {
      padding: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--space-10);
    }

    .faq__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: start;
    }

