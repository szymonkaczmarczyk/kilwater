---
import { Picture } from "astro:assets";
import ropeImage from "../assets/photos/lina.png";
import { toLocale } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(toLocale(Astro.currentLocale)).promise;
---

<section class="promise" aria-labelledby="promise-title">
  <span class="wake-point" data-wake-point="start" aria-hidden="true"></span>
  <div class="promise__inner">
    <p class="label promise__label">{t.label}</p>

    <h2 id="promise-title" class="promise__title">
      {t.titleLines[0]}<br />{t.titleLines[1]}
    </h2>

    <figure class="promise__figure">
      <Picture
        src={ropeImage}
        alt={t.imageAlt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[480, 960, 1280]}
        sizes="(min-width: 1024px) 30vw, 70vw"
        style="object-position: 30% 55%"
      />
    </figure>

    <div class="promise__text">
      <span class="wake-point promise__wake" data-wake-point aria-hidden="true"></span>
      {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .promise {
    position: relative;
    background: var(--surface-page);
    padding: var(--space-9) var(--gutter);
  }

  .promise > .wake-point {
    top: 0;
    left: 62%;
  }

  .promise__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-6);
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .promise__label {
    color: var(--text-muted);
  }

  .promise__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: var(--weight-light);
    line-height: var(--leading-heading);
    letter-spacing: -0.04em;
  }

  .promise__figure {
    margin: 0;
    width: min(100%, 360px);
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px var(--radius-md) var(--radius-md);
    overflow: hidden;
  }

  .promise__figure :global(picture),
  .promise__figure :global(img) {
    width: 100%;
    height: 100%;
  }

  .promise__figure :global(img) {
    object-fit: cover;
  }

  .promise__text {
    position: relative;
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    font-size: var(--size-body-large);
    color: var(--text-muted);
  }

  .promise__wake {
    left: calc(var(--gutter) * -0.5);
    bottom: 0;
  }

  @media (min-width: 1024px) {
    .promise__wake {
      left: calc(var(--space-5) * -2);
    }

    .promise {
      padding-block: var(--space-10);
    }

    .promise__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-7);
    }

    .promise__label {
      grid-column: 1 / span 4;
    }

    .promise__title {
      grid-column: 1 / span 8;
    }

    .promise__figure {
      grid-column: 9 / span 4;
      grid-row: 1 / span 3;
      align-self: start;
      width: 100%;
    }

    .promise__text {
      grid-column: 4 / span 5;
    }
  }
</style>
