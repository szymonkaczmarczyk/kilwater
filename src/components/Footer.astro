---
import Logo from "./Logo.astro";
import { company } from "../data/company";
import { logoMark } from "../data/logo-mark";
import { destinationTexts } from "../data/offer";

const sections = [
  { href: "/#akweny", label: "Akweny" },
  { href: "/#rejsy", label: "Rodzaje rejsów" },
  { href: "/#zaloga", label: "Załoga i dodatki" },
  { href: "/#trasy", label: "Przykładowe trasy" },
  { href: "/#kiedy-plynac", label: "Kiedy płynąć" },
  { href: "/#jak-to-dziala", label: "Jak to działa" },
  { href: "/#faq", label: "Pytania i odpowiedzi" },
  { href: "/#zapytanie", label: "Zaplanuj rejs" },
];

const documents = [
  { href: "/polityka-prywatnosci", label: "Polityka prywatności" },
  { href: "/regulamin", label: "Regulamin" },
];

const wordmarkLetters = [..."KILWATER"];
const year = new Date().getFullYear();
---

<footer class="footer" data-footer>
  <div class="footer__inner">
    <div class="footer__brand">
      <Logo />
      <h2 class="footer__pitch">Twój tydzień na wodzie zaczyna się od <span class="footer__accent">jednej wiadomości</span>.</h2>
      <p class="footer__tagline">
        Napisz, gdzie i kiedy chcesz płynąć. Broker odpowie z propozycją jachtów, trasy i ceny, a zapytanie nic nie kosztuje.
      </p>
      <div class="footer__actions">
        <a class="button button--solid footer__cta" href="/#zapytanie">
          Zaplanuj swój rejs
          <span class="button__arrow" aria-hidden="true">→</span>
        </a>
        <a class="footer__link footer__mail" href={`mailto:${company.email}`}>albo napisz na {company.email}</a>
      </div>
      <div class="footer__start">
        <p class="footer__start-label" id="footer-start-label">Zacznij od akwenu:</p>
        <ul class="footer__destinations" aria-labelledby="footer-start-label">
          {destinationTexts.map((destination) => (
            <li>
              <a class="footer__destination" href={`/?akwen=${destination.slug}#zapytanie`}>
                {destination.name}
                <span class="footer__destination-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="footer__column" aria-label="Sekcje strony">
      <p class="footer__heading">Strona</p>
      <ul>
        {sections.map((link) => <li><a class="footer__link" href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__column">
      <p class="footer__heading">Kontakt</p>
      <ul>
        <li><a class="footer__link" href={`mailto:${company.email}`}>{company.email}</a></li>
        <li><a class="footer__link" href={company.phoneHref}>{company.phone}</a></li>
        <li>
          <address class="footer__address">{company.street}<br />{company.postalCity}</address>
        </li>
      </ul>
    </div>

    <nav class="footer__column" aria-label="Dokumenty">
      <p class="footer__heading">Dokumenty</p>
      <ul>
        {documents.map((link) => <li><a class="footer__link" href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="footer__sea" aria-hidden="true" data-footer-sea>
    <p class="footer__wordmark">
      {wordmarkLetters.map((letter) => (
        <span class="footer__letter" data-footer-letter><span>{letter}</span></span>
      ))}
    </p>
    <svg class="footer__wake" data-footer-wake>
      <path class="footer__wake-line" data-footer-wake-line />
      <g class="footer__boat" data-footer-boat>
        <g transform="scale(1.6) translate(-18 -18.2)">
          <path d={logoMark.hull} />
          <path d={logoMark.sail} />
        </g>
      </g>
    </svg>
  </div>

  <div class="footer__bottom">
    <p>© {year} {company.name}</p>
    <button class="footer__top" type="button" data-scroll-top>
      Wróć na górę
      <span class="footer__top-arrow" aria-hidden="true">↑</span>
    </button>
  </div>
</footer>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, scrollToTarget } from "../scripts/motion";

  const footer = document.querySelector<HTMLElement>("[data-footer]");
  const sea = footer?.querySelector<HTMLElement>("[data-footer-sea]");
  const wake = footer?.querySelector<SVGSVGElement>("[data-footer-wake]");
  const wakeLine = footer?.querySelector<SVGPathElement>("[data-footer-wake-line]");
  const boat = footer?.querySelector<SVGGElement>("[data-footer-boat]");
  const letters = footer ? [...footer.querySelectorAll<HTMLElement>("[data-footer-letter]")] : [];

  footer?.querySelector("[data-scroll-top]")?.addEventListener("click", () => scrollToTarget(0));

  let wakeLength = 0;

  const buildWake = () => {
    if (!sea || !wake || !wakeLine) return;
    const width = sea.clientWidth;
    const height = sea.clientHeight;
    const waterline = height * 0.86;
    const swell = Math.min(14, height * 0.05);
    const waves = 3;
    const step = width / (waves * 2);
    let path = `M0 ${waterline}`;
    for (let index = 0; index < waves * 2; index += 1) {
      const direction = index % 2 === 0 ? -1 : 1;
      path += ` Q${step * index + step / 2} ${waterline + swell * direction} ${step * (index + 1)} ${waterline}`;
    }
    wake.setAttribute("viewBox", `0 0 ${width} ${height}`);
    wakeLine.setAttribute("d", path);
    wakeLength = wakeLine.getTotalLength();
    wakeLine.style.strokeDasharray = String(wakeLength);
  };

  const sail = (progress: number) => {
    if (!wakeLine || !boat || !sea) return;
    const drawn = wakeLength * progress;
    wakeLine.style.strokeDashoffset = String(wakeLength - drawn);
    const point = wakeLine.getPointAtLength(drawn);
    boat.setAttribute("transform", `translate(${point.x} ${point.y})`);
    boat.style.opacity = progress > 0.01 && progress < 0.99 ? "1" : "0";
    const seaLeft = sea.getBoundingClientRect().left;
    letters.forEach((letter) => {
      const box = letter.getBoundingClientRect();
      const letterCenter = box.left - seaLeft + box.width / 2;
      letter.classList.toggle("is-surfaced", point.x >= letterCenter - box.width * 0.6 || progress >= 0.99);
    });
  };

  if (footer && sea && wake && wakeLine && boat) {
    buildWake();
    ScrollTrigger.addEventListener("refresh", buildWake);

    if (prefersReducedMotion()) {
      sail(1);
    } else {
      const state = { progress: 0 };
      ScrollTrigger.create({
        trigger: sea,
        start: "top bottom",
        end: "bottom bottom",
        onUpdate: (self) => gsap.to(state, { progress: self.progress, duration: 0.6, ease: "power3.out", overwrite: true, onUpdate: () => sail(state.progress) }),
      });
      sail(0);
    }

    letters.forEach((letter) => {
      letter.addEventListener("pointerenter", () => letter.classList.add("is-lifted"));
      letter.addEventListener("pointerleave", () => letter.classList.remove("is-lifted"));
    });
  }
</script>

<style>
  .footer {
    background: var(--color-sand-200);
    color: var(--text-strong);
    padding: var(--space-9) var(--gutter) var(--space-5);
    overflow: hidden;
  }

  .footer__inner,
  .footer__bottom {
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .footer__inner {
    display: grid;
    gap: var(--space-7);
  }

  .footer__brand {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .footer__pitch {
    max-width: 18ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--size-h3);
    font-weight: var(--weight-light);
    line-height: var(--leading-heading);
    letter-spacing: -0.02em;
  }

  .footer__accent {
    text-decoration: underline wavy var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 8px;
    text-decoration-skip-ink: none;
  }

  .footer__tagline {
    max-width: 44ch;
    color: var(--text-muted);
  }

  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .footer__cta {
    min-height: 56px;
    padding-inline: var(--space-6);
    font-size: var(--size-body);
  }

  .footer__mail {
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .footer__start {
    display: grid;
    gap: var(--space-3);
  }

  .footer__start-label {
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer__destinations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__destination {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--hit-target);
    padding: 0 var(--space-4);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    font-size: var(--size-small);
    color: var(--text-strong);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .footer__destination-arrow {
    color: var(--accent);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .footer__heading {
    margin-bottom: var(--space-4);
    font-size: var(--size-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .footer__column ul {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    display: inline-block;
    background: linear-gradient(currentColor, currentColor) left 100% / 0 1px no-repeat;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .footer__address {
    font-style: normal;
    color: var(--text-muted);
  }

  .footer__sea {
    position: relative;
    margin: var(--space-9) calc(var(--gutter) * -1) var(--space-5);
    padding: 0 var(--gutter);
  }

  .footer__wordmark {
    display: flex;
    justify-content: space-between;
    max-width: var(--page-max);
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(56px, 16vw, 280px);
    font-weight: var(--weight-light);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-navy-900);
    user-select: none;
  }

  .footer__letter {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .footer__letter > span {
    display: block;
    opacity: 0.12;
    transform: translateY(105%);
    transition:
      transform 900ms var(--ease-out),
      opacity 900ms var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .footer__letter.is-surfaced > span {
    opacity: 0.16;
    transform: none;
  }

  .footer__letter.is-surfaced.is-lifted > span {
    opacity: 1;
    color: var(--accent);
    transform: translateY(-6%);
    transition-duration: var(--duration-base);
  }

  .footer__wake {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .footer__wake-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .footer__boat {
    fill: var(--accent);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--hit-target);
    font-size: var(--size-small);
    color: var(--text-strong);
  }

  .footer__top-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .footer__link:hover {
      background-size: 100% 1px;
    }

    .footer__destination:hover {
      border-color: var(--accent);
      background: var(--color-sand-100);
    }

    .footer__destination:hover .footer__destination-arrow {
      transform: translate(2px, -2px);
    }

    .footer__top:hover .footer__top-arrow {
      transform: translateY(-3px);
    }
  }

  @media (pointer: coarse) {
    .footer__column ul {
      gap: 0;
    }

    .footer__link {
      display: inline-flex;
      align-items: center;
      min-height: var(--hit-target);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__boat {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer {
      padding-top: var(--space-10);
    }

    .footer__inner {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .footer__brand {
      grid-column: auto;
    }
  }
</style>
